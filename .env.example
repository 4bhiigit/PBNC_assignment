# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intel
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/doc_intel

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Authentication
JWT_SECRET=change-me-in-production-min-32-chars-secret-key
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage
# S3 / MinIO (Optional)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# File Upload Limits
MAX_UPLOAD_MB=25
MAX_PAGES=150
MAX_IMAGE_PIXELS=89478485
ALLOWED_MIME=["application/pdf","image/jpeg","image/png"]
UPLOAD_RATE_LIMIT=10/minute

# Extraction & AI Configuration
EXTRACTOR=hybrid
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT_S=30
LLM_MAX_CONCURRENCY=5
LLM_SEND_IMAGE=auto

# OCR & Image Processing
TESSERACT_LANGS=eng+hin
RENDER_DPI=200
TEXT_LAYER_MIN_CHARS=50

# Confidence Thresholds
CONF_EXTRACTED_MIN=0.85
CONF_PARTIAL_MIN=0.60

# Celery Workers
WORKER_CONCURRENCY=4
TASK_SOFT_TIME_LIMIT=300
TASK_HARD_TIME_LIMIT=360
